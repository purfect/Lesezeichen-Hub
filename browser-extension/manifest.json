{
  "manifest_version": 3,
  "name": "Lesezeichen Hub",
  "short_name": "Lesezeichen Hub",
  "version": "1.0.0",
  "description": "Speichert Seiten, Links und markierten Text direkt im lokalen Lesezeichen-Hub.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Im Lesezeichen-Hub speichern",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["api.js", "background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Speichern-Dialog öffnen"
    }
  },
  "permissions": ["storage", "contextMenus", "notifications", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "lesezeichen-hub@purfect.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
